#!/usr/bin/ucode
'use strict';

import * as uci from 'uci';
import * as fs from 'fs';
import { to_int } from 'ubbf';
import { cmd_build } from 'ubbf.utils.process';
import { device_from_name } from 'ubbf.utils.path';
import { log_init, log_info, log_warn, log_debug } from 'ubbf.utils.logging';

log_init('bbf-qos');

let cursor = uci.cursor();

const DEFAULT_CLASS = 10;

// Traffic class numbers are written in decimal into class minors, which tc
// parses as hex, so a minor with a hex letter never collides with one.
const ROOT_CLASS = '1:ffff';

const SHAPED_STATE = '/tmp/ubbf/qos-shaped.json';
const STATUS_STATE = '/tmp/ubbf/qos-status.json';

// Root qdiscs that the kernel or netifd install by default; any other one
// belongs to another component and is left alone.
const REPLACEABLE_QDISCS = [ 'noqueue', 'mq', 'fq_codel', 'pfifo_fast', 'pfifo', 'fq' ];

// Bits 16 to 27 of the packet mark carry the classification that matched
// the layer 2 criteria in the bridge chain; the forward chain tests them.
const L2_MARK_MASK = 0x0fff0000;
const L2_MARK_SHIFT = 16;
const L2_MARK_MAX = 0x0fff;

// The status of each TR-181 row the run handled, read by the module's get
// handlers: Enabled, Error_Misconfigured or Error.
let status = {};

function status_set(path, value) {
	if (!path)
		return;

	// The first problem of a row decides; a later success does not hide it.
	if (status[path] == null || status[path] == 'Enabled')
		status[path] = value;
}

function valid_iface(s) {
	return type(s) == 'string' && s != '' && length(s) <= 32 &&
	       !!match(s, /^[a-zA-Z0-9._-]+$/);
}

function ip_family(s) {
	let addr = (type(s) == 'string') ? iptoarr(s) : null;
	if (!addr)
		return null;
	return (length(addr) == 4) ? 'ip' : 'ip6';
}

/**
 * Converts a TR-181 mask to a prefix length: the IPPrefix form `/24`, a
 * bare length, or a dotted IPv4 mask.
 *
 * @param {string} s - Mask value
 * @param {string} family - 'ip' or 'ip6'
 * @returns {number|null} Prefix length, or null for an invalid mask
 */
function mask_to_prefix(s, family) {
	if (type(s) != 'string' || s == '')
		return null;

	let bits = (family == 'ip') ? 32 : 128;
	let value = ltrim(s, '/');

	if (match(value, /^[0-9]{1,3}$/))
		return (+value <= bits) ? +value : null;

	let mask = (family == 'ip') ? iptoarr(value) : null;
	if (!mask || length(mask) != 4)
		return null;

	let prefix = 0;
	let ended = false;
	for (let octet in mask) {
		for (let bit = 7; bit >= 0; bit--) {
			let set = (octet >> bit) & 1;
			if (set && ended)
				return null;
			if (set)
				prefix++;
			else
				ended = true;
		}
	}
	return prefix;
}

function valid_mac(s) {
	return type(s) == 'string' &&
	       !!match(s, /^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}$/);
}

/**
 * Runs a command and logs its output when it fails.
 *
 * @param {array} parts - Command parts for cmd_build()
 * @returns {boolean} True when the command succeeded
 */
function run(parts) {
	let cmd = cmd_build([ ...parts, {raw: '2>&1'} ]);
	log_debug('%s', cmd);

	let p = fs.popen(cmd, 'r');
	if (!p) {
		log_warn('cannot run %s', cmd);
		return false;
	}

	let out = p.read('all');
	let rc = p.close();
	if (rc != 0) {
		log_warn('%s failed (%d): %s', cmd, rc, trim(out ?? ''));
		return false;
	}
	return true;
}

/**
 * Reads the output of a command.
 *
 * @param {array} parts - Command parts for cmd_build()
 * @returns {string|null} Standard output, or null when the command failed
 */
function read_cmd(parts) {
	let p = fs.popen(cmd_build([ ...parts, {raw: '2>/dev/null'} ]), 'r');
	if (!p)
		return null;
	let out = p.read('all');
	return (p.close() == 0) ? out : null;
}

function tc(...parts) {
	return run([ {raw: 'tc'}, ...parts ]);
}

function nft(...parts) {
	return run([ {raw: 'nft'}, ...parts ]);
}

/**
 * Resolves the interface of a section to its kernel device: the device of
 * a netifd interface, or a netdev of that name (an Ethernet port or a
 * bridge port that TR-181 references at layer 1 or 2).
 *
 * @param {string} name - Interface name from the config
 * @returns {string|null} Device name
 */
function device_resolve(name) {
	if (!valid_iface(name))
		return null;
	return device_from_name(name) ?? (fs.stat(`/sys/class/net/${name}`) ? name : null);
}

/**
 * Converts a TR-181 rate to bits per second. A value from 1 to 100 is a
 * percent of the link rate of the device, a larger value is in bits per
 * second.
 *
 * @param {number} value - ShapingRate or similar
 * @param {string} dev - Kernel device
 * @returns {number|null} Bits per second, or null when the rate cannot be
 *          known
 */
function rate_bits(value, dev) {
	if (value == null || value <= 0)
		return null;
	if (value > 100)
		return value;

	let speed = to_int(trim(fs.readfile(`/sys/class/net/${dev}/speed`) ?? ''));
	if (speed == null || speed <= 0) {
		log_warn('%s: no link rate for a rate of %d percent', dev, value);
		return null;
	}
	return speed * 1000000 * value / 100;
}

function rate_arg(bits) {
	return sprintf('%dbit', bits);
}

function previous_shaped() {
	let data = fs.readfile(SHAPED_STATE);
	if (!data)
		return [];
	try {
		let devs = json(data);
		return (type(devs) == 'array') ? devs : [];
	} catch (e) {
		return [];
	}
}

/**
 * Tests whether this module may replace the root qdisc of a device: the
 * kernel default, or the HTB that a previous run installed.
 *
 * @param {string} dev - Kernel device
 * @param {array} previous - Devices shaped by the previous run
 * @returns {boolean} True when the root qdisc can be replaced
 */
function root_qdisc_ours(dev, previous) {
	let out = read_cmd([ {raw: 'tc'}, '-j', 'qdisc', 'show', 'dev', dev, 'root' ]);
	let qdiscs;
	try {
		qdiscs = json(out ?? '[]');
	} catch (e) {
		return false;
	}

	for (let q in qdiscs) {
		if (!q.root)
			continue;
		if (index(REPLACEABLE_QDISCS, q.kind) >= 0)
			return true;
		return q.kind == 'htb' && index(previous, dev) >= 0;
	}
	return true;
}

let shaped = {};

function apply_shapers() {
	let previous = previous_shaped();
	let configured = [];

	cursor.foreach('bbf-qos', 'shaper', (s) => {
		if (s.enabled == '1')
			push(configured, device_resolve(s.interface));
	});

	for (let dev in previous)
		if (index(configured, dev) < 0)
			tc('qdisc', 'del', 'dev', dev, 'root');

	cursor.foreach('bbf-qos', 'shaper', (s) => {
		if (s.enabled != '1')
			return;

		let dev = device_resolve(s.interface);
		if (!dev) {
			log_warn('shaper %s: interface %s has no device', s.path, s.interface);
			return status_set(s.path, 'Error_Misconfigured');
		}

		let rate = to_int(s.shaping_rate);
		if (rate == null || rate == -1) {
			if (index(previous, dev) >= 0)
				tc('qdisc', 'del', 'dev', dev, 'root');
			return status_set(s.path, 'Enabled');
		}

		let bits = rate_bits(rate, dev);
		if (!bits)
			return status_set(s.path, 'Error_Misconfigured');

		if (shaped[dev]) {
			log_warn('shaper %s: %s has a shaper already', s.path, dev);
			return status_set(s.path, 'Error_Misconfigured');
		}

		if (!root_qdisc_ours(dev, previous)) {
			log_warn('shaper %s: %s has a root qdisc of another component', s.path, dev);
			return status_set(s.path, 'Error_Misconfigured');
		}

		log_info('shaper %s: dev=%s rate=%dbit', s.path, dev, bits);

		let burst = to_int(s.shaping_burst_size);
		let root = [ 'class', 'add', 'dev', dev, 'parent', '1:', 'classid', ROOT_CLASS,
		             'htb', 'rate', rate_arg(bits) ];
		if (burst > 0)
			push(root, 'burst', burst);

		// HTB sends unclassified traffic to the default class, and a default
		// that does not exist bypasses the shaper; a queue with traffic class
		// 10, or with none, replaces this leaf with its own parameters
		if (index(previous, dev) >= 0)
			tc('qdisc', 'del', 'dev', dev, 'root');
		let ok = tc('qdisc', 'replace', 'dev', dev, 'root', 'handle', '1:', 'htb', 'default', DEFAULT_CLASS) &&
			tc(...root) &&
			tc('class', 'add', 'dev', dev, 'parent', ROOT_CLASS, 'classid', sprintf('1:%d', DEFAULT_CLASS),
			   'htb', 'rate', rate_arg(bits));

		shaped[dev] = bits;
		status_set(s.path, ok ? 'Enabled' : 'Error');
	});

	fs.writefile(SHAPED_STATE, sprintf('%J\n', keys(shaped)));
}

/**
 * Returns the traffic classes of a queue section, or the default class
 * for a queue that names none.
 *
 * The minor of the HTB class and of the nft priority holds the class
 * number in decimal and is parsed as hex, so a class is valid from 1 to
 * 9999. Class 0 would name the qdisc itself.
 */
function queue_classes(q) {
	let list = q.traffic_classes;
	if (type(list) != 'array')
		list = (list != null) ? [ list ] : [];

	let classes = [];
	for (let item in list) {
		let n = to_int(item);
		if (n == null || n < 1 || n > 9999)
			return null;
		push(classes, n);
	}

	return length(classes) ? uniq(classes) : [ DEFAULT_CLASS ];
}

function htb_class(dev, parent, classid, q) {
	let parts = [ 'class', 'replace', 'dev', dev, 'parent', parent, 'classid', classid,
	              'htb', 'rate', rate_arg(q.rate), 'ceil', rate_arg(q.ceil) ];

	// HTB adds the quantum in bytes to a class per round, so the weight
	// scales a full-size frame; prio takes 0 to 7, TR-181 Precedence
	// starts at 1.
	if (q.algorithm == 'WRR' || q.algorithm == 'WFQ')
		push(parts, 'quantum', max(1, q.weight) * 1500);
	else
		push(parts, 'prio', min(7, max(0, q.precedence - 1)));

	if (q.burst > 0)
		push(parts, 'burst', q.burst);

	return tc(...parts);
}

let inner_count = 0;

/**
 * Adds the HTB classes of one queue.
 *
 * A packet reaches a leaf through its priority 1:<class>, so each traffic
 * class of the queue needs its own leaf. With more than one class, an
 * inner class carries the rate of the queue and the leaves share it. The
 * minor of the inner class has a hex letter, as ROOT_CLASS.
 */
function queue_classes_add(dev, classes, q) {
	if (length(classes) == 1)
		return htb_class(dev, ROOT_CLASS, sprintf('1:%d', classes[0]), q);

	let inner = sprintf('1:e%03x', inner_count++);
	let ok = htb_class(dev, ROOT_CLASS, inner, q);

	let share = max(1, q.rate / length(classes));
	for (let n in classes)
		ok = htb_class(dev, inner, sprintf('1:%d', n), { ...q, rate: share, ceil: q.rate }) && ok;

	return ok;
}

function apply_queues() {
	cursor.foreach('bbf-qos', 'queue', (q) => {
		if (q.enabled != '1')
			return;

		let dev = device_resolve(q.interface);
		if (!dev || !shaped[dev]) {
			log_warn('queue %s: interface %s has no shaper', q.path, q.interface ?? '');
			return status_set(q.path, 'Error_Misconfigured');
		}

		let classes = queue_classes(q);
		if (!classes) {
			log_warn('queue %s: invalid traffic classes', q.path);
			return status_set(q.path, 'Error_Misconfigured');
		}

		// A queue without a rate of its own may use the whole shaper.
		let rate = to_int(q.shaping_rate);
		let bits = (rate == null || rate == -1) ? shaped[dev] : rate_bits(rate, dev);
		if (!bits)
			return status_set(q.path, 'Error_Misconfigured');

		let params = {
			rate: min(bits, shaped[dev]),
			ceil: min(bits, shaped[dev]),
			weight: to_int(q.weight) ?? 1,
			precedence: to_int(q.precedence) ?? 1,
			algorithm: q.scheduler_algorithm ?? 'SP',
			burst: to_int(q.shaping_burst_size)
		};

		log_info('queue %s: dev=%s classes=%s rate=%dbit algo=%s', q.path, dev,
			join(',', classes), params.rate, params.algorithm);

		status_set(q.path, queue_classes_add(dev, classes, params) ? 'Enabled' : 'Error');
	});
}

let policers = {};

function apply_policers() {
	cursor.foreach('bbf-qos', 'policer', (p) => {
		if (p.enabled != '1' || !p.path)
			return;

		let rate = to_int(p.committed_rate);
		if (rate == null || rate <= 0) {
			log_warn('policer %s: no committed rate', p.path);
			return status_set(p.path, 'Error_Misconfigured');
		}

		let bytes = max(1, rate / 8);
		let burst = to_int(p.committed_burst_size);
		if (burst == null || burst <= 0)
			burst = bytes;

		let name = sprintf('pol_%s', replace(p.path, /^.*\./, ''));
		log_info('policer %s: %d bytes/s burst %d', p.path, bytes, burst);

		// One limit object per policer, so every rule that names it shares
		// the committed rate.
		let ok = nft('add', 'limit', 'inet', 'bbf_qos', name,
			{raw: sprintf("'{ rate over %d bytes/second burst %d bytes }'", bytes, burst)});

		policers[p.path] = ok ? name : null;
		status_set(p.path, ok ? 'Enabled' : 'Error');
	});
}

/**
 * Returns the nft families a classification applies to: the family of its
 * addresses or of its IP Ethertype, or both when it has none. Returns
 * null when the criteria mix families or name an invalid address, and an
 * empty array for a non-IP Ethertype, which only the bridge chain sees.
 */
function classify_families(c) {
	let families = [];

	for (let addr in [ c.source_ip, c.dest_ip ]) {
		if (!addr)
			continue;

		let family = ip_family(addr);
		if (!family)
			return null;
		push(families, family);
	}

	let ethertype = to_int(c.ethertype);
	if (ethertype == 0x0800)
		push(families, 'ip');
	else if (ethertype == 0x86dd)
		push(families, 'ip6');
	else if (ethertype != null && ethertype >= 0)
		return length(families) ? null : [];

	families = uniq(families);
	if (length(families) > 1)
		return null;

	return length(families) ? families : [ 'ip', 'ip6' ];
}

function addr_expr(addr, mask, family) {
	if (!mask)
		return addr;

	let prefix = mask_to_prefix(mask, family);
	return (prefix != null) ? sprintf('%s/%d', addr, prefix) : null;
}

/**
 * Returns the bridge chain criteria of a classification: VLAN ID, VLAN
 * priority (TR-181 EthernetPriorityCheck) and a non-IP Ethertype.
 */
function l2_match(c) {
	let m = [];

	let vlan_id = to_int(c.vlan_id_check);
	if (vlan_id != null && vlan_id >= 0)
		push(m, 'vlan', 'id', vlan_id);

	let pcp = to_int(c.ethernet_priority_check);
	if (pcp != null && pcp >= 0)
		push(m, 'vlan', 'pcp', pcp);

	let ethertype = to_int(c.ethertype);
	if (ethertype != null && ethertype >= 0 && ethertype != 0x0800 && ethertype != 0x86dd)
		push(m, 'ether', 'type', sprintf('0x%04x', ethertype));

	return m;
}

function nft_build_match(c, family) {
	let m = [ 'meta', 'nfproto', family == 'ip' ? 'ipv4' : 'ipv6' ];

	if (c.device)
		push(m, 'iifname', c.device);

	let protocol = to_int(c.protocol);
	if (protocol != null && protocol >= 0)
		push(m, 'meta', 'l4proto', protocol);

	if (c.source_ip) {
		let src = addr_expr(c.source_ip, c.source_mask, family);
		if (!src)
			return null;
		push(m, family, 'saddr', src);
	}

	if (c.dest_ip) {
		let dst = addr_expr(c.dest_ip, c.dest_mask, family);
		if (!dst)
			return null;
		push(m, family, 'daddr', dst);
	}

	let src_port = to_int(c.source_port);
	if (src_port != null && src_port >= 0) {
		let src_port_max = to_int(c.source_port_range_max);
		push(m, 'th', 'sport', (src_port_max > src_port) ? sprintf('%d-%d', src_port, src_port_max) : src_port);
	}

	let dst_port = to_int(c.dest_port);
	if (dst_port != null && dst_port >= 0) {
		let dst_port_max = to_int(c.dest_port_range_max);
		push(m, 'th', 'dport', (dst_port_max > dst_port) ? sprintf('%d-%d', dst_port, dst_port_max) : dst_port);
	}

	if (c.source_mac_address) {
		if (!valid_mac(c.source_mac_address))
			return null;
		push(m, 'ether', 'saddr', c.source_mac_address);
	}

	if (c.dest_mac_address) {
		if (!valid_mac(c.dest_mac_address))
			return null;
		push(m, 'ether', 'daddr', c.dest_mac_address);
	}

	let dscp_check = to_int(c.dscp_check);
	if (dscp_check != null && dscp_check >= 0)
		push(m, family, 'dscp', dscp_check);

	let ip_len_min = to_int(c.ip_length_min);
	let ip_len_max = to_int(c.ip_length_max);
	// In the forward hook meta length is the packet length from the
	// network header on, which is the TR-181 IPLength for both families;
	// ip6 length would leave out the 40-byte fixed header.
	if (ip_len_min > 0 && ip_len_max > 0)
		push(m, 'meta', 'length', sprintf('%d-%d', ip_len_min, ip_len_max));
	else if (ip_len_min > 0)
		push(m, 'meta', 'length', '>=', ip_len_min);
	else if (ip_len_max > 0)
		push(m, 'meta', 'length', '<=', ip_len_max);

	if (c.l2_mark)
		push(m, 'meta', 'mark', 'and', sprintf('0x%08x', L2_MARK_MASK), '==',
		     sprintf('0x%08x', c.l2_mark << L2_MARK_SHIFT));

	return m;
}

function nft_build_actions(c, family) {
	let actions = [];

	let dscp_mark = to_int(c.dscp_mark);
	if (family && dscp_mark != null && dscp_mark >= 0)
		push(actions, family, 'dscp', 'set', dscp_mark);

	let traffic_class = to_int(c.traffic_class);
	if (traffic_class != null && traffic_class >= 0)
		push(actions, 'meta', 'priority', 'set', sprintf('1:%d', traffic_class));

	return actions;
}

/**
 * Returns the verdict that ends the classification on a match: none when
 * StopProcessing is false, so that the next entries also apply.
 */
function classify_verdict(c) {
	return (c.stop_processing == '0') ? [] : [ 'accept' ];
}

/**
 * Adds the rules of one classification to the forward and output chains.
 * The output chain classifies traffic of the CPE itself, which has no
 * ingress interface and passes no bridge chain.
 */
function classify_rules_add(c, families) {
	let ok = true;
	let chains = (c.device || c.l2_mark || c.source_mac_address || c.dest_mac_address)
		? [ 'forward' ] : [ 'forward', 'output' ];

	for (let family in families) {
		let matches = nft_build_match(c, family);
		if (!matches) {
			log_warn('classify %s: invalid mask or MAC address', c.path);
			return 'Error_Misconfigured';
		}

		for (let chain in chains) {
			if (c.policer)
				ok = nft('add', 'rule', 'inet', 'bbf_qos', chain, ...matches,
					'limit', 'name', c.policer, 'counter', 'drop') && ok;

			ok = nft('add', 'rule', 'inet', 'bbf_qos', chain, ...matches,
				...nft_build_actions(c, family), ...classify_verdict(c)) && ok;
		}
	}

	return ok ? 'Enabled' : 'Error';
}

/**
 * Adds the bridge chain rule of a classification with layer 2 criteria.
 * It marks the frame for the forward chain; a classification without an
 * IP family is applied here alone.
 */
function classify_l2_add(c, l2, families) {
	let parts = [ 'add', 'rule', 'bridge', 'bbf_qos_l2', 'prerouting' ];
	if (c.device)
		push(parts, 'iifname', c.device);

	if (!length(families)) {
		let dscp_mark = to_int(c.dscp_mark);
		if (dscp_mark != null && dscp_mark >= 0) {
			log_warn('classify %s: a non-IP Ethertype has no DSCP', c.path);
			return false;
		}
		return nft(...parts, ...l2, ...nft_build_actions(c, null), ...classify_verdict(c));
	}

	return nft(...parts, ...l2, 'meta', 'mark', 'set', 'meta', 'mark', 'and',
		sprintf('0x%08x', ~L2_MARK_MASK & 0xffffffff), 'or',
		sprintf('0x%08x', c.l2_mark << L2_MARK_SHIFT));
}

function apply_classifications() {
	let rules = [];
	cursor.foreach('bbf-qos', 'classify', (c) => {
		if (c.enabled == '1')
			push(rules, { ...c, order: to_int(c.order) ?? 0x7fffffff, instance: to_int(c.instance) ?? 0 });
	});

	rules = sort(rules, (a, b) => (a.order != b.order) ? a.order - b.order : a.instance - b.instance);

	let l2_count = 0;
	for (let c in rules) {
		if (c.interface_ref && c.all_interfaces != '1') {
			c.device = device_resolve(c.interface);
			if (!c.device) {
				log_warn('classify %s: interface %s has no device', c.path, c.interface_ref);
				status_set(c.path, 'Error_Misconfigured');
				continue;
			}
		}

		if (c.policer) {
			c.policer = policers[rtrim(c.policer, '.')];
			if (!c.policer) {
				log_warn('classify %s: policer is not enabled', c.path);
				status_set(c.path, 'Error_Misconfigured');
				continue;
			}
		}

		let families = classify_families(c);
		if (families == null) {
			log_warn('classify %s: invalid or mixed match criteria', c.path);
			status_set(c.path, 'Error_Misconfigured');
			continue;
		}

		let l2 = l2_match(c);
		if (length(l2)) {
			if (++l2_count > L2_MARK_MAX) {
				status_set(c.path, 'Error_Misconfigured');
				continue;
			}
			c.l2_mark = l2_count;
			if (!classify_l2_add(c, l2, families)) {
				status_set(c.path, 'Error_Misconfigured');
				continue;
			}
		}

		log_info('classify %s: order=%d iface=%s', c.path, c.order, c.device ?? 'all');
		status_set(c.path, length(families) ? classify_rules_add(c, families) : 'Enabled');
	}
}

function tables_reset() {
	for (let t in [ [ 'inet', 'bbf_qos' ], [ 'bridge', 'bbf_qos_l2' ] ]) {
		nft('add', 'table', ...t);
		nft('delete', 'table', ...t);
		nft('add', 'table', ...t);
	}

	nft('add', 'chain', 'inet', 'bbf_qos', 'forward', {raw: "'{ type filter hook forward priority mangle; }'"});
	nft('add', 'chain', 'inet', 'bbf_qos', 'output', {raw: "'{ type filter hook output priority mangle; }'"});
	nft('add', 'chain', 'bridge', 'bbf_qos_l2', 'prerouting', {raw: "'{ type filter hook prerouting priority -300; }'"});
}

if (!cursor.load('bbf-qos')) {
	log_debug('no bbf-qos config found');
	exit(0);
}

log_info('applying QoS configuration');

fs.mkdir('/tmp/ubbf');
tables_reset();
apply_shapers();
apply_queues();
apply_policers();
apply_classifications();

fs.writefile(STATUS_STATE, sprintf('%J\n', status));

log_info('QoS configuration applied');
