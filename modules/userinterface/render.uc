let certificates = {};
include('../security/certificates.uc', { certificates });

/**
 * Resolves the Certificate and CABundle references of an HTTPAccess row.
 * An empty Certificate leaves the device certificate to ubbf-ui. A
 * Certificate without a key falls back to the device certificate as well,
 * because a listener that cannot load its key would stop every listener of
 * the web UI. A CABundle that does not resolve sets `ca_missing`, and the
 * listener stays off rather than accept clients without a certificate.
 *
 * @param {string} inst - Instance number
 * @param {object} data - HTTPAccess row
 * @returns {object} `{ cert, key, ca_dir, ca_missing }`, each optional
 */
function tls_paths(inst, data) {
	let out = {};

	if (data.Certificate) {
		let cert = certificates.certificate_path_resolve(data.Certificate);
		let key = cert ? certificates.certificate_key_path(cert) : null;
		if (key) {
			out.cert = cert;
			out.key = key;
		} else {
			warn(`userinterface: HTTPAccess.${inst} Certificate ${data.Certificate} ${cert ? 'has no key' : 'does not resolve'}, using the device certificate\n`);
		}
	}

	if (data.CABundle) {
		out.ca_dir = certificates.cabundle_path_resolve(data.CABundle);
		out.ca_missing = !out.ca_dir;
		if (out.ca_missing)
			warn(`userinterface: HTTPAccess.${inst} CABundle ${data.CABundle} does not resolve, listener disabled\n`);
	}

	return out;
}

function render_config() {
	let ui = ubbf_get(config, 'Device.UserInterface');
	if (!ui) {
		services.set_enabled('ubbf-ui', false);
		return;
	}

	let http_access = ubbf_instances(config, 'Device.UserInterface.HTTPAccess');
	let ui_on = ubbf_to_bool(ui.Enable ?? 'true');
	services.set_enabled('ubbf-ui', ui_on && length(http_access) > 0);
	if (!ui_on || !length(http_access))
		return;

	/**
	 * Generates UCI webui server section and firewall rule.
	 *
	 * @param {string} inst - Instance number
	 * @param {object} data - HTTPAccess data model object
	 * @returns {string} UCI batch output for webui server
	 */
	function generate_server_instance(inst, data) {

		let https = data.Protocol == 'HTTPS';
		let tls = https ? tls_paths(inst, data) : {};
		let iface = data.Interface ? ubbf_get(config, data.Interface) : null;

		// A listener without its interface would take connections on every
		// device, the LAN included
		let iface_missing = data.Interface && !iface?.Name;
		if (iface_missing)
			warn(`userinterface: HTTPAccess.${inst} Interface ${data.Interface} does not resolve, listener disabled\n`);

		uci_section(output, 'webui server');
		uci_set_boolean(output, 'webui.@server[-1].enabled',
			ubbf_to_bool(data.Enable) && !tls.ca_missing && !iface_missing);
		uci_set_number(output, 'webui.@server[-1].port', ubbf_to_int(data.Port));
		uci_set_string(output, 'webui.@server[-1].protocol', lc(data.Protocol));
		uci_set_string(output, 'webui.@server[-1].tls_min_version', data.X_UBBF_TLSMinVersion ?? '1.2');

		if (tls.cert) {
			uci_set_string(output, 'webui.@server[-1].certificate', tls.cert);
			uci_set_string(output, 'webui.@server[-1].private_key', tls.key);
		}
		if (tls.ca_dir)
			uci_set_string(output, 'webui.@server[-1].ca_directory', tls.ca_dir);

		if (iface?.Name)
			uci_set_string(output, 'webui.@server[-1].interface', iface.Name);

		uci_set_number(output, 'webui.@server[-1].instance', ubbf_to_int(data['.instance']));
		uci_set_string(output, 'webui.@server[-1].alias', data.Alias ?? '');
		uci_set_string(output, 'webui.@server[-1].access_type', data.AccessType ?? 'LocalAccess');

		for (let ref in split(data.AllowedRoles ?? '', ',')) {
			let role = ubbf_get(config, rtrim(trim(ref), '.'));
			if (ubbf_to_bool(role?.Enable) && role?.RoleName)
				uci_list_string(output, 'webui.@server[-1].allowed_role', role.RoleName);
		}

		uci_set_boolean(output, 'webui.@server[-1].allow_all_ipv4', ubbf_to_bool(data.AllowAllIPv4));
		uci_set_boolean(output, 'webui.@server[-1].allow_all_ipv6', ubbf_to_bool(data.AllowAllIPv6));

		for (let key in [ 'IPv4AllowedSourcePrefix', 'IPv6AllowedSourcePrefix' ])
			for (let prefix in split(data[key] ?? '', ','))
				if (trim(prefix) != '')
					uci_list_string(output, 'webui.@server[-1].allowed_prefix', trim(prefix));

		return;
	}

	for (let inst, data in http_access)
		generate_server_instance(inst, data);
}
uci_comment(output, '# generated by userinterface/render.uc');
render_config();
