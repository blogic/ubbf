function render_config() {
	const CLOSED_VID_TOP = 4094;

	let certificates = {};
	include('../security/certificates.uc', { certificates, instance_map: instance_map_readonly });

	let ieee8021x = {};
	include('shared.uc', { ieee8021x, certificates });

	/**
	 * Collects the VLAN IDs that the bridges and the VLAN terminations use.
	 *
	 * @returns {object} Map of VID to true
	 */
	function vids_used() {
		let used = { ...(render_state.bridge_vids_used ?? {}) };
		for (let key, entry in render_state.vt_bridge_vlans ?? {})
			used[entry.vid] = true;
		return used;
	}

	/**
	 * Returns the next free VLAN ID below `vid`, and marks it as used.
	 *
	 * @param {object} used - Map of VID to true, changed in place
	 * @param {number} vid - The VID to start at
	 * @returns {number|null} A free VID, or null if none is left
	 */
	function vid_take(used, vid) {
		while (vid > 0 && used[vid])
			vid--;
		if (vid <= 0)
			return null;
		used[vid] = true;
		return vid;
	}

	/**
	 * Finds the VLAN-aware bridge that has a port on a netdev.
	 *
	 * @param {string} netdev - Netdev of the port
	 * @returns {string|null} Bridge name, or null
	 */
	function port_bridge(netdev) {
		for (let br_name, bridge in render_state.bridge ?? {})
			if (index(bridge.eth_ports ?? [], netdev) >= 0)
				return br_name;
		return null;
	}

	/**
	 * Makes the bridge a member of the closed VLAN of a port. netifd adds an
	 * auth_vlan to the port only, and no other port joins this VLAN.
	 *
	 * @param {string} br_name - Bridge name
	 * @param {string} netdev - Netdev of the port
	 * @param {number} vid - VLAN ID
	 */
	function closed_vlan_section(br_name, netdev, vid) {
		let section = `auth_${replace(netdev, /[^A-Za-z0-9_]/g, '_')}`;

		uci_named_section(output, `network.${section}`, 'bridge-vlan');
		uci_set_string(output, `network.${section}.device`, br_name);
		uci_set_number(output, `network.${section}.vlan`, vid);
	}

	// netifd keeps a port with `auth` closed until the ubbf-device plugin
	// reports an authorised station through network.device set_state. On a
	// VLAN-aware bridge the switch gives EAPOL frames to the CPU only from a
	// VLAN that the bridge is a member of, so each closed port has a VLAN of
	// its own. A row that cannot run leaves its port open.
	let used = vids_used();
	let next_vid = CLOSED_VID_TOP;
	let closed = {};
	let rows = sort(ubbf_instances(config, 'Device.IEEE8021x.X_UBBF_Authenticator'),
		(a, b) => ubbf_to_int(a['.instance']) - ubbf_to_int(b['.instance']));

	for (let row in rows) {
		if (!ubbf_to_bool(row.enable))
			continue;

		let plan = ieee8021x.authenticator_plan(config, row);
		if (plan.error) {
			warn('ieee8021x: X_UBBF_Authenticator.%s: %s', row['.instance'], plan.error);
			continue;
		}

		let br_name = port_bridge(plan.netdev);
		let vid = br_name ? vid_take(used, next_vid) : null;
		if (br_name && vid == null) {
			warn('ieee8021x: X_UBBF_Authenticator.%s: no free VLAN ID for the closed port', row['.instance']);
			continue;
		}

		closed[plan.netdev] = true;
		device_state_set(render_state, plan.netdev, 'auth', '1');
		if (!br_name)
			continue;

		next_vid = vid - 1;
		device_state_set(render_state, plan.netdev, 'auth_vlan', [ `${vid}:u` ]);
		closed_vlan_section(br_name, plan.netdev, vid);
	}

	// netifd keeps the last auth value of a device when a reload drops the
	// option, so the other ports state it.
	for (let iface in ubbf_instances(config, 'Device.Ethernet.Interface')) {
		if (iface.Name && !closed[iface.Name])
			device_state_set(render_state, iface.Name, 'auth', '0');
	}
}
uci_comment(output, '# generated by ieee8021x/render.uc');
render_config();
