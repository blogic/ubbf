function render_config() {
	let ddns = {};

	include(sourcepath(0, true) + '/common.uc', { ubbf, dm_visible, upstream_interface_ref, ddns });

	// A client that names no check interval relies on the hotplug restart
	// when its address changes and checks once a day.
	const CHECK_INTERVAL_DEFAULT = 86400;

	/**
	 * Builds the update URL of the generic service dyndns2, the /nic/update
	 * protocol most DDNS servers speak. ddns-scripts replaces the [..]
	 * fields and switches to https for use_https.
	 *
	 * @param {object} server - Server row
	 * @returns {string} URL template
	 */
	function dyndns2_url(server) {
		let port = ubbf_to_int(server.ServerPort) ?? 0;
		let host = (index(server.ServerAddress, ':') >= 0) ? `[${server.ServerAddress}]` : server.ServerAddress;

		return sprintf('http://[USERNAME]:[PASSWORD]@%s%s/nic/update?hostname=[DOMAIN]&myip=[IP]',
			host, (port > 0) ? sprintf(':%d', port) : '');
	}

	/**
	 * Writes one UCI 'config service' section for a Client/Hostname pair
	 * and one IP version.
	 *
	 * @param {object} client - Client row
	 * @param {object} server - Server row the client references
	 * @param {string} name - Hostname to update
	 * @param {string} section_name - UCI section name
	 * @param {object} target - { family, network }
	 */
	function service_write(client, server, name, section_name, target) {
		let s = `ddns.${section_name}`;

		uci_comment(output, sprintf('## DDNS %s IPv%d', name, target.family));
		uci_named_section(output, s, 'service');
		uci_set_boolean(output, `${s}.enabled`, true);
		uci_set_boolean(output, `${s}.use_ipv6`, target.family == 6);

		if (server.ServiceName == 'dyndns2')
			uci_set_string(output, `${s}.update_url`, dyndns2_url(server));
		else
			uci_set_string(output, `${s}.service_name`, server.ServiceName);

		uci_set_boolean(output, `${s}.use_https`, server.Protocol != 'HTTP');

		uci_set_string(output, `${s}.domain`, name);
		uci_set_string(output, `${s}.lookup_host`, replace(name, /^\*\./, ''));

		if (client.Username)
			uci_set_string(output, `${s}.username`, client.Username);

		if (client.Password)
			uci_set_secret(output, `${s}.password`, client.Password);

		// ddns-scripts reads the address of ip_network from netifd; the
		// hotplug script restarts the section on events of `interface`.
		uci_set_string(output, `${s}.interface`, target.network);
		uci_set_string(output, `${s}.bind_network`, target.network);
		uci_set_string(output, `${s}.ip_source`, 'network');
		uci_set_string(output, `${s}.ip_network`, target.network);

		let check_interval = ubbf_to_int(server.CheckInterval) || CHECK_INTERVAL_DEFAULT;
		uci_set_number(output, `${s}.check_interval`, check_interval);
		uci_set_number(output, `${s}.check_interval_min`, check_interval);
		uci_set_string(output, `${s}.check_unit`, 'seconds');

		let retry_interval = ubbf_to_int(server.RetryInterval);
		if (retry_interval > 0) {
			uci_set_number(output, `${s}.retry_interval`, retry_interval);
			uci_set_string(output, `${s}.retry_unit`, 'seconds');
		}

		// TR-181: N retries, then no request until the context changes.
		// ddns-scripts reads 0 as endless, and 1 is its smallest limit.
		uci_set_number(output, `${s}.retry_max_count`, max(ubbf_to_int(server.MaxRetries) ?? 0, 1));
	}

	/**
	 * Generates UCI ddns service sections from DynamicDNS Client+Hostname
	 * pairs: one section per hostname and address family of an enabled
	 * client whose enabled Server names a service.
	 */
	function generate_ddns() {
		let any_enabled = false;

		for (let client in ubbf_instances(config, 'Device.DynamicDNS.Client')) {
			if (!ubbf_to_bool(client.Enable))
				continue;

			let server = client.Server ? ubbf_get(config, client.Server) : null;
			if (!server || !ubbf_to_bool(server.Enable) || !server.ServiceName)
				continue;
			if (server.ServiceName == 'dyndns2' && !server.ServerAddress)
				continue;

			let targets = ddns.client_networks(config, client);
			let both = length(targets) > 1;

			for (let hostname in ubbf_instances(config, client['.path'] + '.Hostname')) {
				if (!ubbf_to_bool(hostname.Enable) || !hostname.Name)
					continue;

				any_enabled = true;

				for (let target in targets)
					service_write(client, server, hostname.Name,
						ddns.section_name(client['.instance'], hostname['.instance'], target.family, both),
						target);
			}
		}

		services.set_enabled('ddns', any_enabled);
	}

	if (!ubbf_get(config, 'Device.DynamicDNS')) {
		services.set_enabled('ddns', false);
		return;
	}

	generate_ddns();
}
uci_comment(output, '# generated by ddns/render.uc');
render_config();
