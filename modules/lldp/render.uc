function render_config() {
	let lldp = ubbf_get(config, 'Device.LLDP');

	// `Enable` is the name before the X_UBBF_ prefix; a stored
	// configuration may still have only that key.
	let enable = ubbf_to_bool(lldp?.X_UBBF_Enable ?? lldp?.Enable);

	services.set_enabled('lldpd', enable);

	if (!enable)
		return;

	let caps = [ 'router', 'bridge' ];
	if (length(ubbf_instances(config, 'Device.WiFi.Radio')))
		push(caps, 'wlan');

	uci_named_section(output, 'lldpd.config', 'lldpd');
	uci_set_number(output, 'lldpd.config.lldp_class', 4);
	uci_set_string(output, 'lldpd.config.lldp_description', 'Internet Gateway');
	uci_set_string(output, 'lldpd.config.lldp_syscapabilities', join(',', caps));
	uci_list_string(output, 'lldpd.config.interface', 'lan');

	// Without a pattern lldpd advertises the first global address of any
	// interface, which can be the WAN address.
	let lan_status = netifd_status_get('lan');
	let lan_device = lan_status?.l3_device ?? lan_status?.device;
	if (lan_device)
		uci_set_string(output, 'lldpd.config.lldp_mgmt_ip', lan_device);
	else
		uci_set_boolean(output, 'lldpd.config.lldp_mgmt_addr_advertisements', false);

	// The LLDP-MED inventory TLVs would tell every LAN host the firmware
	// build and the board.
	uci_set_boolean(output, 'lldpd.config.lldpmed_no_inventory', true);
}
uci_comment(output, '# generated by lldp/render.uc');
render_config();
