function render_config() {
// nlbwmon counts a flow when exactly one side is in local_network. The LAN
// side is each downstream interface, which the nlbwmon init script resolves
// to its IPv4 subnets and IPv6 prefixes; multicast, broadcast and link-local
// traffic stays on the LAN, so it is local as well and is not counted.
const LOCAL_RANGES = [
	'224.0.0.0/4',
	'255.255.255.255/32',
	'169.254.0.0/16',
	'ff00::/8',
	'fe80::/10'
];

	services.set_enabled('nlbwmon', true);

	uci_named_section(output, 'nlbwmon.nlbwmon', 'nlbwmon');
	uci_set_string(output, 'nlbwmon.nlbwmon.database_directory', '/tmp/nlbwmon');
	uci_set_string(output, 'nlbwmon.nlbwmon.commit_interval', '24d');
	uci_set_number(output, 'nlbwmon.nlbwmon.database_generations', 1);

	uci_delete(output, 'nlbwmon.nlbwmon.local_network');

	for (let iface in ubbf_instances(config, 'Device.IP.Interface') ?? []) {
		if (ubbf_to_bool(iface.Upstream) || !ubbf_to_bool(iface.Enable) || !iface.Name)
			continue;
		uci_list_string(output, 'nlbwmon.nlbwmon.local_network', iface.Name);
	}

	for (let range in LOCAL_RANGES)
		uci_list_string(output, 'nlbwmon.nlbwmon.local_network', range);
}
uci_comment(output, '# generated by hosts/render.uc');
render_config();
