#!/bin/sh /etc/rc.common

START=51
STOP=89

USE_PROCD=1
PROG=/usr/sbin/ubbf-logd
CONF_DIR=/var/run/ubbf-logd
LOG_DIR=/var/log
SOCKET_DIR=/var/run/ubbf-syslog

start_service() {
	mkdir -p "$CONF_DIR" "$LOG_DIR" "$SOCKET_DIR"

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	# A controller chooses the file paths and the certificates, so the
	# daemon sees only these. It stays root to read the keys of the
	# certificates, which are root-owned with mode 0600.
	procd_add_jail ubbf-logd ubus log
	procd_add_jail_mount "$PROG"
	procd_add_jail_mount /lib/ /usr/lib/
	procd_add_jail_mount /etc/ssl/certs/ /etc/ubbf/
	procd_add_jail_mount "$CONF_DIR/"
	procd_add_jail_mount_rw "$LOG_DIR/" "$SOCKET_DIR/"
	procd_set_param capabilities /etc/capabilities/ubbf-logd.json
	procd_set_param no_new_privs 1
	procd_close_instance
}

reload_service() {
	ubus call ubbf-logd reload
}
