#!/bin/sh /etc/rc.common
# Applies the USB device authorization of Device.USB.USBHosts.AllowedDevice
# (UCI ubbf_usb). New devices are handled by hotplug.d/usb/30-ubbf-usb-allow.

START=20
USE_PROCD=1

start_service() {
	/usr/libexec/ubbf/usb-allow apply
}

reload_service() {
	/usr/libexec/ubbf/usb-allow apply
}

service_triggers() {
	procd_add_reload_trigger "ubbf_usb"
}
