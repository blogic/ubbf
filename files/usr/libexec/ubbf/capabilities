#!/usr/bin/env ucode
'use strict';

import * as uci from 'uci';
import { readfile, writefile, mkdir, unlink } from 'fs';
import { radios_extract } from 'ubbf.utils.wifi_radio';

function devices_extract(iface) {
	if (!iface)
		return [];

	if (iface.device)
		return [ iface.device ];

	if (iface.ports)
		return [ ...iface.ports ];

	return [];
}

function network_extract(board) {
	let network = board?.network;
	if (!network)
		return {};

	return {
		wan: devices_extract(network.wan),
		lan: devices_extract(network.lan)
	};
}

let board_json = readfile('/etc/board.json');
let board = board_json ? json(board_json) : null;

// Wifi detection writes the radios to /etc/config; the override directory holds
// the rendered config, which has no radio after a render without capabilities.
let cursor = uci.cursor('/etc/config', null, '');
let wireless_config = cursor.load('wireless') ? cursor.get_all('wireless') : {};

let capabilities = {
	radios: radios_extract(board, wireless_config),
	network: network_extract(board)
};

mkdir('/tmp/ubbf');
if (writefile('/tmp/ubbf/capabilities.json', sprintf('%.J\n', capabilities)) == null)
	exit(1);

unlink('/etc/ubbf/capabilities.json');
