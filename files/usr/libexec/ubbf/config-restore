#!/usr/bin/ucode --
'use strict';

// Applies a downloaded configuration file over the live data model. The
// USP VendorConfigFile Restore command reaches config_restore() in the data
// model directly; CWMP arrives here instead, because cwmpd has already
// fetched the file and hands it to scripts/apply.sh. The data model runs in
// the bbf-dm process, so the restore goes over ubus.

import * as ubus from 'ubus';
import { log_init, log_info, log_err } from 'ubbf.utils.logging';

// An apply and the rollback of a failed one each restart services.
const RESTORE_TIMEOUT = 300;

log_init('ubbf-config-restore');

let source = ARGV[0];
if (!source) {
	warn('usage: config-restore <file>\n');
	exit(1);
}

let conn = ubus.connect(null, RESTORE_TIMEOUT);
let result = conn?.call({ object: 'bbf-dm', method: 'restore', data: { file: source } });
if (!result?.success) {
	log_err('restore failed: %s', result?.error ?? ubus.error() ?? 'unknown error');
	exit(1);
}

log_info('restored configuration from %s', source);
exit(0);
