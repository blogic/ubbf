/**
 * Board name as preinit records it, or the --board override.
 *
 * @returns {string} board name, empty when unknown
 */
function board_name_read() {
	if (opts.board)
		return opts.board;
	return trim(fs.readfile('/tmp/sysinfo/board_name') ?? '');
}

/**
 * Queries usfpd for the netdev -> Device.Optical.Interface.{i} mapping.
 *
 * Invokes `usfpd --probe-json`, a one-shot CLI mode that runs the same
 * sysfs/ethtool discovery + EEPROM classification as the daemon but
 * synchronously, so default_config can call it from uci-defaults time
 * (before procd has started usfpd as a daemon). The CLI prints a JSON
 * array sorted by cage name; this function filters to optical cages and
 * assigns 1-based instance numbers in that order, matching the live
 * Device.Optical.Interface.{i} numbering.
 *
 * @returns {object} Map of netdev name to optical instance number; empty
 *                   when usfpd is absent or no optical cages exist
 */
function optical_cages_query() {
	let result = {};
	let p = fs.popen('/usr/sbin/usfpd --probe-json 2>/dev/null', 'r');
	if (!p)
		return result;

	let output = p.read('all');
	p.close();
	if (!output)
		return result;

	let probe = json(output);
	if (type(probe) != 'array')
		return result;

	let idx = 0;
	for (let entry in probe) {
		if (!entry.optical)
			continue;
		idx++;
		result[entry.netdev] = idx;
	}
	return result;
}

function ethernet_generate(network, optical_map) {
	let interfaces = {};
	let links = {};
	let eth_instance = 1;
	let link_instance = 1;
	let wan_index = 1;
	let lan_index = 1;

	for (let device in network.wan) {
		let optical_idx = optical_map?.[device];
		let lower_path;

		if (optical_idx) {
			lower_path = sprintf('Device.Optical.Interface.%d', optical_idx);
		} else {
			interfaces[eth_instance] = {
				Enable: 'true',
				Alias: device,
				Name: device,
				Upstream: 'true',
				MaxBitRate: '-1',
				DuplexMode: 'Auto'
			};
			lower_path = sprintf('Device.Ethernet.Interface.%d', eth_instance);
			eth_instance++;
		}

		links[link_instance] = {
			Enable: 'true',
			Alias: length(network.wan) > 1 ? sprintf('eth-WAN%d', wan_index) : 'eth-WAN',
			Name: device,
			LowerLayers: lower_path,
			MACAddress: ''
		};

		wan_index++;
		link_instance++;
	}

	for (let device in network.lan) {
		let optical_idx = optical_map?.[device];
		let lower_path;

		if (optical_idx) {
			lower_path = sprintf('Device.Optical.Interface.%d', optical_idx);
		} else {
			interfaces[eth_instance] = {
				Enable: 'true',
				Alias: device,
				Name: device,
				Upstream: 'false',
				MaxBitRate: '-1',
				DuplexMode: 'Auto'
			};
			lower_path = sprintf('Device.Ethernet.Interface.%d', eth_instance);
			eth_instance++;
		}

		links[link_instance] = {
			Enable: 'true',
			Alias: length(network.lan) > 1 ? sprintf('eth-LAN%d', lan_index) : 'eth-LAN',
			Name: device,
			LowerLayers: lower_path,
			MACAddress: ''
		};

		lan_index++;
		link_instance++;
	}

	return {
		Interface: interfaces,
		Link: links
	};
}

function bridging_generate(network, wifi) {
	let bridge_ports = {};
	let port_instance = 1;

	bridge_ports[port_instance] = {
		Enable: 'true',
		Alias: 'br-lan',
		Name: 'br-lan',
		ManagementPort: 'true',
		LowerLayers: ''
	};
	port_instance++;

	let link_instance = length(network.wan) + 1;
	let lan_index = 1;

	for (let device in network.lan) {
		bridge_ports[port_instance] = {
			Enable: 'true',
			Alias: sprintf('LanPort%d', lan_index),
			Name: sprintf('lanport%d', lan_index),
			ManagementPort: 'false',
			LowerLayers: sprintf('Device.Ethernet.Link.%d', link_instance)
		};
		port_instance++;
		lan_index++;
		link_instance++;
	}

	if (wifi) {
		let num_radios = wifi._num_radios;
		let ssid_refs = [];
		for (let i = 1; i <= num_radios; i++)
			push(ssid_refs, sprintf('Device.WiFi.SSID.%d', i));

		bridge_ports[port_instance] = {
			Enable: 'true',
			Alias: 'WiFiPort',
			Name: 'wifiport',
			ManagementPort: 'false',
			LowerLayers: join(',', ssid_refs)
		};
	}

	return {
		Enable: 'true',
		Alias: 'LAN',
		Name: 'br-lan',
		Standard: '802.1Q-2011',
		Port: bridge_ports
	};
}

