#!/usr/bin/env ucode

'use strict';

import * as fs from 'fs';
import { cursor } from 'uci';

// Host use: `default_config --dry-run [--initial FILE] [--capabilities FILE]
// [--board NAME] [--mode NAME]` prints the four mode presets and the test
// profiles of the given mode as JSON and writes nothing.
let opts = {
	dry_run: false,
	initial: '/usr/share/ucode/ubbf/initial.json',
	capabilities: '/tmp/ubbf/capabilities.json',
	board: null,
	mode: null
};

for (let i = 0; i < length(ARGV); i++) {
	switch (ARGV[i]) {
	case '--dry-run':
		opts.dry_run = true;
		break;
	case '--initial':
		opts.initial = ARGV[++i];
		break;
	case '--capabilities':
		opts.capabilities = ARGV[++i];
		break;
	case '--board':
		opts.board = ARGV[++i];
		break;
	case '--mode':
		opts.mode = ARGV[++i];
		break;
	}
}

if (!opts.dry_run && fs.stat('/etc/ubbf/config.json')?.size)
	exit(0);

