				PrivateKey: '/etc/ubbf/cert.key'
			}
		}
	};
} else {
	config.Device.SSH = {
		Enable: 'true',
		Server: {
			'1': {
				Enable: 'false',
				Alias: 'LANSSHDisabled',
				Interface: 'Device.IP.Interface.2',
				Port: '22',
				IdleTimeout: '300',
				KeepAlive: '300',
				AllowRootLogin: 'false',
				AllowPasswordLogin: 'true',
				AllowRootPasswordLogin: 'false',
				MaxAuthTries: '3'
			},
			'2': {
				Enable: 'false',
				Alias: 'WANSSHDisabled',
				Interface: 'Device.IP.Interface.1',
				Port: '22',
				IdleTimeout: '300',
				KeepAlive: '300',
				AllowRootLogin: 'true',
				AllowPasswordLogin: 'true',
				AllowRootPasswordLogin: 'true',
				MaxAuthTries: '3'
			}
		}
	};
	config.Device.UserInterface = {
		Enable: 'true',
		HTTPAccess: {
			'1': {
				Enable: 'true',
				Alias: 'LanWebUI',
				Interface: 'Device.IP.Interface.2',
				Port: '80',
				Protocol: 'HTTP'
			},
			'2': {
				Enable: 'true',
				Alias: 'LanHTTPS',
				Interface: 'Device.IP.Interface.2',
				Port: '443',
				Protocol: 'HTTPS',
				Certificate: '/etc/ubbf/cert.pem',
				PrivateKey: '/etc/ubbf/cert.key'
			},
			'3': {
				Enable: 'true',
				Alias: 'WanHTTPS',
				Interface: 'Device.IP.Interface.1',
				Port: '443',
				Protocol: 'HTTPS',
				Certificate: '/etc/ubbf/cert.pem',
				PrivateKey: '/etc/ubbf/cert.key'
			}
		}
	};
}

let discovery;
try {
	discovery = cursor().get('obuspa', 'acs', 'discovery');
} catch (e) {
	discovery = null;
}

if (discovery == 'dhcp') {
	let devinfo = usp_device_info_get(network);
	if (devinfo)
		usp_discovery_opts_add(config, devinfo);
}

let runtimes = capabilities.runtimes ?? [];
if (length(runtimes)) {
	config.Device.SoftwareModules = softwaremodules_generate(runtimes);
}

// Device operating mode presets: router, dumb-ap, agent and cellular. All
// four are emitted at first boot so the testbed can switch modes at runtime
// (bbf-dm apply <file>); config.json is the one the /etc/ubbf/mode marker
// selects. Absent marker means router.
let has_network = length(network.wan) || length(network.lan);

let router_preset = config;

let agent_preset = json(sprintf('%.J', router_preset));
agent_preset.Device.WiFi ??= {};
agent_preset.Device.WiFi.DataElements ??= {};
agent_preset.Device.WiFi.DataElements.Network ??= {};
agent_preset.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh ??= {};
agent_preset.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh.Agent = { Enable: 'true' };

let dumbap_preset = has_network
	? router_to_dumb_ap(json(sprintf('%.J', router_preset)), network, wifi ? wifi._num_radios : 0)
	: json(sprintf('%.J', router_preset));

let modem_path = CELLULAR.modem_path_by_board[board_name_read()] ?? '';

let cellular_preset = has_network
	? router_to_cellular(json(sprintf('%.J', router_preset)), network, modem_path)
	: json(sprintf('%.J', router_preset));

let mode = opts.mode ?? trim(fs.readfile('/etc/ubbf/mode') ?? '');
if (!mode)
	mode = 'router';

// The test profiles the testbed resets the device to between suites. They
// start from the router shape and take the mode's WAN, since a reset that
// restored a wired WAN on a cellular device would drop its only uplink.
let test_config = json(initial_json);
delete test_config.Device.LLDP;

if (has_network) {
	test_config.Device.SSH = {
		Enable: 'true',
		Server: {
			'1': {
				Enable: 'true',
				Alias: 'LANDevSSH',
				Interface: '',
				Port: '22',
				IdleTimeout: '300',
				KeepAlive: '300',
				AllowRootLogin: 'true',
				AllowPasswordLogin: 'true',
				AllowRootPasswordLogin: 'true',
				MaxAuthTries: '3'
			}
		}
	};
	test_config.Device.Firewall ??= {};
	test_config.Device.Firewall.Chain ??= {};
	test_config.Device.Firewall.Chain['1'] ??= {
		Enable: 'true',
		Alias: 'InputChain',
		Name: 'INPUT'
	};
	test_config.Device.Firewall.Chain['1'].Rule ??= {};
	test_config.Device.Firewall.Chain['1'].Rule['1'] = {
		Enable: 'true',
		Alias: 'WANDevSSH',
		Target: 'Accept',
		Protocol: '6',
		DestPort: '22',
		SourceInterface: 'Device.IP.Interface.1'
	};
	test_config.Device.Firewall.Chain['1'].Rule['2'] = {
		Enable: 'true',
		Alias: 'LANDevSSH',
		Target: 'Accept',
		Protocol: '6',
		DestPort: '22',
		SourceInterface: 'Device.IP.Interface.2'
	};
	test_config.Device.UserInterface = {
		Enable: 'true',
		HTTPAccess: {
			'1': {
				Enable: 'true',
				Alias: 'LanWebUI',
				Interface: 'Device.IP.Interface.2',
				Port: '80',
				Protocol: 'HTTP'
			},
			'2': {
				Enable: 'true',
				Alias: 'LanHTTPS',
				Interface: 'Device.IP.Interface.2',
				Port: '443',
				Protocol: 'HTTPS',
				Certificate: '/etc/ubbf/cert.pem',
				PrivateKey: '/etc/ubbf/cert.key'
			}
		}
	};
	test_config.Device.Ethernet = ethernet_generate(network, optical_map);
	test_config.Device.Bridging ??= {};
	test_config.Device.Bridging.Bridge ??= {};
	test_config.Device.Bridging.Bridge['1'] = bridging_generate(network, null);

	test_config.Device.WiFi ??= {};
	test_config.Device.WiFi.DataElements ??= {};
	test_config.Device.WiFi.DataElements.Network ??= {};
	test_config.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh ??= {};
	test_config.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh.Bridge = 'Device.Bridging.Bridge.1';
	test_config.Device.WiFi.X_UBBF_QoSMap = config.Device.WiFi.X_UBBF_QoSMap;

	if (wifi)
		test_config.Device.WiFi.Radio = wifi.Radio;
}

if (length(runtimes))
	test_config.Device.SoftwareModules = softwaremodules_generate(runtimes);

if (mode == 'cellular' && has_network)
	router_to_cellular(test_config, network, modem_path);

// prpl_config.json: test_config with the Firewall hierarchy fully
// replaced by the prpl-spec Policy-mode shape. Level, Policy and
// Chain rows use numeric instance keys so the bbf-test harness's
// dut_query (numeric-only instance filter) can discover them.
// Named addressing (Chain.Medium, Policy.WAN2LAN_medium, Level.Medium)
// continues to work via the ubbf module's alias resolver matching
// Alias or Name fields. InterfaceSetting is not seeded here; the
// apply path's firewall_reconcile synthesises it from NAT and IP.
let prpl_config = json(sprintf('%.J', test_config));

prpl_config.Device.Firewall = {
	Enable: 'true',
	Config: 'Policy',
	PolicyLevel: 'Device.Firewall.Level.1.',
	Level: {
		'1': {
			Alias: 'Medium',
			Name: 'Medium',
			Description: 'prpl certification firewall level',
			DefaultPolicy: 'Drop',
			Policies: 'Device.Firewall.Policy.1,Device.Firewall.Policy.2'
		}
	},
	Policy: {
		'1': {
			Enable: 'true',
			Alias: 'WAN2LAN_medium',
			SourceInterface: 'Device.IP.Interface.1',
			DestinationInterface: 'Device.IP.Interface.2',
			IPVersion: '4',
			Chain: 'Device.Firewall.Chain.1.',
			TargetChain: 'Chain'
		},
		'2': {
			Enable: 'true',
			Alias: 'IPV6_WAN2LAN_medium',
			SourceInterface: 'Device.IP.Interface.1',
			DestinationInterface: 'Device.IP.Interface.2',
			IPVersion: '6',
			Chain: 'Device.Firewall.Chain.2.',
			TargetChain: 'Chain'
		}
	},
	Chain: {
		'1': {
			Enable: 'true',
			Alias: 'Medium',
			Name: 'Medium'
		},
		'2': {
			Enable: 'true',
			Alias: 'IPV6_Medium',
			Name: 'IPV6_Medium'
		}
	}
};

if (opts.dry_run) {
	print(sprintf('%.J\n', {
		router: router_preset,
		'dumb-ap': dumbap_preset,
		agent: agent_preset,
		cellular: cellular_preset,
		test: test_config,
		prpl: prpl_config
	}));
	exit(0);
}

let active = router_preset;
if (mode == 'agent')
	active = agent_preset;
else if (mode == 'dumb-ap')
	active = dumbap_preset;
else if (mode == 'cellular')
	active = cellular_preset;

if (fs.mkdir('/etc/ubbf', 0755) == null && !fs.stat('/etc/ubbf')) {
	warn('default_config: failed to create /etc/ubbf\n');
	exit(1);
}

if (fs.writefile('/etc/ubbf/config.json', sprintf('%.J', active)) == null) {
	warn('default_config: failed to write /etc/ubbf/config.json\n');
	exit(1);
}

let mode_presets = [
	[ '/etc/ubbf/config-router.json', router_preset ],
	[ '/etc/ubbf/config-dumb-ap.json', dumbap_preset ],
	[ '/etc/ubbf/config-agent.json', agent_preset ],
	[ '/etc/ubbf/config-cellular.json', cellular_preset ]
];
for (let preset in mode_presets)
	if (fs.writefile(preset[0], sprintf('%.J', preset[1])) == null)
		warn('default_config: failed to write %s\n', preset[0]);

fs.writefile('/etc/ubbf/active-preset', mode);

if (fs.writefile('/etc/ubbf/test_config.json', sprintf('%.J', test_config)) == null)
	warn('default_config: failed to write /etc/ubbf/test_config.json\n');

if (fs.writefile('/etc/ubbf/prpl_config.json', sprintf('%.J', prpl_config)) == null)
	warn('default_config: failed to write /etc/ubbf/prpl_config.json\n');

exit(0);
