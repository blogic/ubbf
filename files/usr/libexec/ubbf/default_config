/**
 * @param {object} radio_info - Radio info from capabilities with modes array
 * @returns {boolean} True if radio supports EHT (802.11be)
 */
function band_has_eht(radio_info) {
	if (!radio_info?.modes)
		return false;

	for (let mode in radio_info.modes) {
		if (index(mode, 'EHT') == 0)
			return true;
	}

	return false;
}

/**
 * Reads the wireless country code from the provisioning partition.
 *
 * The partition survives a factory reset, so a country stored there keeps
 * the regulatory domain across one. The provision package is optional, so
 * the module is loaded at runtime.
 *
 * @returns {string|null} Country code, or null when there is none
 */
function provision_country_get() {
	let provision;

	try {
		provision = import('provision');
	} catch (e) {
		return;
	}

	let ctx = provision.open();
	if (!ctx)
		return;

	ctx.init();

	let country = ctx.get('wireless.country');
	if (type(country) != 'string' || !length(country))
		return;

	return uc(country);
}

function wifi_generate(radios) {
	let band_order = ['2g', '5g', '6g'];
	let sorted_bands = filter(band_order, band => band in radios);
	let num_radios = length(sorted_bands);

	if (num_radios == 0)
		return null;

	let home_psk = 'aaaaaaaa';
	let guest_psk = 'aaaaaaaa';

	let country = provision_country_get() ?? 'DE';

	let radio_entries = {};
	let ssid_entries = {};
	let ap_entries = {};

	let radio_instance = 1;
	let ssid_home_instance = 1;
	let ssid_guest_instance = num_radios + 1;
	let ap_home_instance = 1;
	let ap_guest_instance = num_radios + 1;

	for (let band in sorted_bands) {
		let cfg = band_config[band];
		let radio_info = radios[band];

		let standards = cfg.standards;
		if (band_has_eht(radio_info))
			standards += ',be';

		radio_entries[radio_instance] = {
			Enable: 'true',
			Alias: sprintf('Radio%s', cfg.alias_suffix),
			Name: radio_info.name ?? sprintf('radio%d', radio_instance - 1),
			OperatingFrequencyBand: cfg.freq,
			OperatingStandards: standards,
			Channel: cfg.channel,
			AutoChannelEnable: 'false',
			OperatingChannelBandwidth: cfg.bandwidth,
			TransmitPower: '100',
			RegulatoryDomain: country
		};

		ssid_entries[ssid_home_instance] = {
			Enable: 'true',
			Alias: sprintf('SSID%s', cfg.alias_suffix),
			Name: cfg.wlan_prefix,
			LowerLayers: sprintf('Device.WiFi.Radio.%d', radio_instance),
			SSID: 'Home',
			MACAddress: ''
		};

		ssid_entries[ssid_guest_instance] = {
			Enable: 'true',
			Alias: sprintf('GuestSSID%s', cfg.alias_suffix),
			Name: sprintf('%s-guest', cfg.wlan_prefix),
			LowerLayers: sprintf('Device.WiFi.Radio.%d', radio_instance),
			SSID: 'Guest',
			MACAddress: ''
		};

		ap_entries[ap_home_instance] = {
			Enable: 'true',
			Alias: sprintf('AP%s', cfg.alias_suffix),
			SSIDReference: sprintf('Device.WiFi.SSID.%d', ssid_home_instance),
			SSIDAdvertisementEnabled: 'true',
			WMMEnable: 'true',
			X_UBBF_Role: 'Primary',
			Security: {
				ModeEnabled: 'WPA2-Personal',
				PreSharedKey: home_psk
			}
		};

		ap_entries[ap_guest_instance] = {
			Enable: 'true',
			Alias: sprintf('GuestAP%s', cfg.alias_suffix),
			SSIDReference: sprintf('Device.WiFi.SSID.%d', ssid_guest_instance),
			SSIDAdvertisementEnabled: 'true',
			WMMEnable: 'true',
			IsolationEnable: 'true',
			X_UBBF_Role: 'Guest',
			Security: {
				ModeEnabled: 'WPA2-Personal',
				PreSharedKey: guest_psk
			}
		};

		radio_instance++;
		ssid_home_instance++;
		ssid_guest_instance++;
		ap_home_instance++;
		ap_guest_instance++;
	}

	let templates;
	let eht_bands = [];

	for (let i = 0; i < num_radios; i++) {
		if (band_has_eht(radios[sorted_bands[i]]))
			push(eht_bands, i);
	}

	if (length(eht_bands) >= 2) {
		templates = {
			APMLDTemplate: {
				'1': {
					Alias: 'HomeMLO',
					APMLDTemplateID: '1',
					MLOEnable: 'true',
					STREnable: 'true'
				},
				'2': {
					Alias: 'GuestMLO',
					APMLDTemplateID: '2',
					MLOEnable: 'true',
					STREnable: 'true'
				}
			}
		};

		for (let i in eht_bands) {
			let home_ap = i + 1;
			let guest_ap = num_radios + 1 + i;

			ap_entries[home_ap].APMLDTemplateRef = 'Device.WiFi.Templates.APMLDTemplate.1';
			ap_entries[guest_ap].APMLDTemplateRef = 'Device.WiFi.Templates.APMLDTemplate.2';

			if (sorted_bands[i] == '6g') {
				ap_entries[home_ap].Security = {
					ModeEnabled: 'WPA3-Personal',
					SAEPassphrase: home_psk
				};
				ap_entries[guest_ap].Security = {
					ModeEnabled: 'WPA3-Personal',
					SAEPassphrase: guest_psk
				};
			}
		}
	}

	return {
		Radio: radio_entries,
		SSID: ssid_entries,
		AccessPoint: ap_entries,
		Templates: templates,
		_num_radios: num_radios,
		_sorted_bands: sorted_bands
	};
}

