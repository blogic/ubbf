/**
 * @param {string} str - ASCII string
 * @returns {string} Hex-encoded string
 */
function hex_encode(str) {
	let result = '';
	for (let i = 0; i < length(str); i++)
		result += sprintf('%02x', ord(str, i));
	return result;
}

/**
 * @param {number} val - Integer value
 * @param {number} bytes - Number of bytes
 * @returns {string} Big-endian hex encoding
 */
function hex_uint(val, bytes) {
	return sprintf(`%0${bytes * 2}x`, val);
}

/**
 * @param {string} device - Network interface name
 * @returns {string|null} MAC address as uppercase hex without colons
 */
function mac_read(device) {
	if (!device)
		return null;

	let mac = fs.readfile(`/sys/class/net/${device}/address`);
	if (!mac)
		return null;

	return join('', split(trim(uc(mac)), ':'));
}

/**
 * Reads USP device identification from the WAN MAC address.
 *
 * @param {object} network - Network capabilities with wan array
 * @returns {object|null} Object with oui, serial, product, or null
 */
function usp_device_info_get(network) {
	let wan_device = network?.wan?.[0];
	let mac = mac_read(wan_device);
	if (!mac || length(mac) < 12)
		return null;

	return {
		oui: substr(mac, 0, 6),
		serial: substr(mac, 6, 6),
		product: 'Router'
	};
}

/**
 * Adds USP discovery SentOption/ReqOption entries to the DHCPv4 and DHCPv6 clients.
 *
 * @param {object} config - Config data model to modify
 * @param {object} devinfo - Device info with oui, serial, product
 */
function usp_discovery_opts_add(config, devinfo) {
	let dhcpv4_client = config.Device?.DHCPv4?.Client?.['1'];
	if (dhcpv4_client) {
		let opt124_hex = hex_uint(BBF_ENTERPRISE_ID, 4)
			+ hex_uint(3, 1) + hex_encode('usp');

		let sub1 = hex_uint(1, 1) + hex_uint(length(devinfo.oui), 1) + hex_encode(devinfo.oui);
		let sub2 = hex_uint(2, 1) + hex_uint(length(devinfo.serial), 1) + hex_encode(devinfo.serial);
		let sub3 = hex_uint(3, 1) + hex_uint(length(devinfo.product), 1) + hex_encode(devinfo.product);
		let subopts = sub1 + sub2 + sub3;
		let opt125_hex = hex_uint(BBF_ENTERPRISE_ID, 4)
			+ hex_uint(length(subopts) / 2, 1) + subopts;

		dhcpv4_client.SentOption = {
			'1': {
				Enable: 'true',
				Alias: 'USPVendorClass',
				Tag: '124',
				Value: opt124_hex
			},
			'2': {
				Enable: 'true',
				Alias: 'USPVendorSpecific',
				Tag: '125',
				Value: opt125_hex
			}
		};

		dhcpv4_client.ReqOption = {
			'1': {
				Enable: 'true',
				Alias: 'USPVendorSpecificReq',
				Tag: '125'
			}
		};
	}

	let dhcpv6_client = config.Device?.DHCPv6?.Client?.['1'];
	if (dhcpv6_client) {
		let opt16_hex = hex_uint(BBF_ENTERPRISE_ID, 4)
			+ hex_uint(3, 2) + hex_encode('usp');

		let sub11 = hex_uint(11, 2) + hex_uint(length(devinfo.oui), 2) + hex_encode(devinfo.oui);
		let sub12 = hex_uint(12, 2) + hex_uint(length(devinfo.serial), 2) + hex_encode(devinfo.serial);
		let sub13 = hex_uint(13, 2) + hex_uint(length(devinfo.product), 2) + hex_encode(devinfo.product);
		let opt17_hex = hex_uint(BBF_ENTERPRISE_ID, 4) + sub11 + sub12 + sub13;

		dhcpv6_client.SentOption = {
			'1': {
				Enable: 'true',
				Alias: 'USPVendorClass',
				Tag: '16',
				Value: opt16_hex
			},
			'2': {
				Enable: 'true',
				Alias: 'USPVendorSpecific',
				Tag: '17',
				Value: opt17_hex
			}
		};
	}
}

const capability_defs = {
	'OCI Runtime': {
		Specification: 'OCIImage',
		SpecificationVersion: '1.0.2',
		SpecificationURI: 'https://github.com/opencontainers/runtime-spec'
	},
	'LXC': {
		Specification: 'LXC',
		SpecificationVersion: '1.0',
		SpecificationURI: 'https://linuxcontainers.org/lxc'
	}
};

/**
 * @param {array} runtimes - Detected container runtimes from capabilities.json
 * @returns {object} SoftwareModules config section with ExecEnvClass and ExecEnv
 */
function softwaremodules_generate(runtimes) {
	let execenv_classes = {};
	let execenvs = {};

	for (let i = 0; i < length(runtimes); i++) {
		let rt = runtimes[i];
		let inst = sprintf('%d', i + 1);
		let alias = sprintf('cpe-%s', rt.name);

		execenv_classes[inst] = {
			Alias: alias,
			Name: rt.name,
			Vendor: rt.vendor,
			Version: rt.version,
			Capability: {}
		};

		let cap = capability_defs[rt.type];
		if (cap)
			execenv_classes[inst].Capability['1'] = cap;

		execenvs[inst] = {
			Enable: 'true',
			Alias: alias,
			Name: rt.name,
			Vendor: rt.vendor,
			Version: rt.version,
			Type: rt.type
		};
	}

	return { ExecEnvClass: execenv_classes, ExecEnv: execenvs };
}

/**
 * Deletes every instance under a container whose Interface field matches.
 *
 * @param {object} container - Multi-instance object (e.g. HTTPAccess)
 * @param {string} iface_path - TR-181 interface path to drop
 */
function instances_by_interface_drop(container, iface_path) {
	if (type(container) != 'object')
		return;
	for (let key in keys(container))
		if (container[key]?.Interface == iface_path)
			delete container[key];
}

/**
 * Moves the WAN links into the LAN bridge: one bridge port per WAN link,
 * and the Ethernet interfaces below those links no longer face upstream.
 *
 * @param {object} config - Config to transform (mutated in place)
 * @param {object} network - Network capabilities with wan/lan device arrays
 */
function wan_links_bridge(config, network) {
	let dev = config.Device;

	let ports = dev.Bridging.Bridge['1'].Port;
	let next_port = length(keys(ports)) + 1;
	for (let i = 1; i <= length(network.wan); i++) {
		ports[next_port] = {
			Enable: 'true',
			Alias: length(network.wan) > 1 ? sprintf('WanPort%d', i) : 'WanPort',
			Name: length(network.wan) > 1 ? sprintf('wanport%d', i) : 'wanport',
			ManagementPort: 'false',
			LowerLayers: sprintf('Device.Ethernet.Link.%d', i)
		};
		next_port++;

		let m = match(dev.Ethernet?.Link?.[i]?.LowerLayers ?? '', /^Device\.Ethernet\.Interface\.(\d+)$/);
		if (m && dev.Ethernet.Interface?.[m[1]])
			dev.Ethernet.Interface[m[1]].Upstream = 'false';
	}
}

/**
 * Drops the management services bound to the wired WAN interface.
 *
 * @param {object} dev - The config's Device object (mutated in place)
 */
function wan_services_drop(dev) {
	instances_by_interface_drop(dev.UserInterface?.HTTPAccess, 'Device.IP.Interface.1');
	instances_by_interface_drop(dev.SSH?.Server, 'Device.IP.Interface.1');
	instances_by_interface_drop(dev.X_UBBF?.QoSify?.InterfaceConfig, 'Device.IP.Interface.1');
}

/**
 * Rewrites a fully-built router config into a dumb-AP (bridged) config: a
 * single flat L2 bridge spanning every wired port plus WiFi, one management
 * interface addressed by DHCP, and no routing/NAT/DHCP-server/firewall. The
 * former LAN interface (instance 2) is kept as the management interface so
 * management services already bound to it stay valid.
 *
 * @param {object} config - The router config to transform (mutated in place)
 * @param {object} network - Network capabilities with wan/lan device arrays
 * @param {number} num_radios - Number of WiFi radios (for guest SSID removal)
 * @returns {object} The mutated config
 */
function router_to_dumb_ap(config, network, num_radios) {
	let dev = config.Device;

	wan_links_bridge(config, network);

	let mgmt = dev.IP.Interface['2'];
	mgmt.Alias = 'Management';
	mgmt.IPv4Address['1'].AddressingType = 'DHCP';
	mgmt.IPv4Address['1'].IPAddress = '';
	mgmt.IPv4Address['1'].SubnetMask = '';
	delete mgmt.IPv6Prefix;
	delete dev.IP.Interface['1'];
	delete dev.IP.Interface['3'];

	dev.DHCPv4.Client['1'].Interface = 'Device.IP.Interface.2';
	dev.DHCPv4.Client['1'].Alias = 'MgmtDHCPv4Client';
	delete dev.DHCPv4.Server;
	if (dev.DHCPv6?.Client?.['1']) {
		dev.DHCPv6.Client['1'].Interface = 'Device.IP.Interface.2';
		dev.DHCPv6.Client['1'].RequestPrefixes = 'false';
	}
	if (dev.DHCPv6)
		delete dev.DHCPv6.Server;

	delete dev.NAT;
	delete dev.Routing;
	delete dev.Firewall;
	delete dev.RouterAdvertisement;
	delete dev.NeighborDiscovery;
	if (dev.DNS) {
		delete dev.DNS.Relay;
		delete dev.DNS.RebindProtection;
	}

	delete dev.Bridging.Bridge['2'];
	delete dev.QoS;
	for (let i = num_radios + 1; i <= 2 * num_radios; i++) {
		if (dev.WiFi?.SSID)
			delete dev.WiFi.SSID[i];
		if (dev.WiFi?.AccessPoint)
			delete dev.WiFi.AccessPoint[i];
	}

	wan_services_drop(dev);

	return config;
}

/**
 * Rewrites a fully-built router config into a cellular router: every wired
 * port joins the LAN bridge and the WAN interface rides the LTE modem. The
 * routed side, NAT, firewall, DHCP and DNS relay, stays as the router has it,
 * and so does the LAN's ULA addressing; the DHCP clients, the WAN's own
 * prefix and the services bound to the wired WAN go, since the modem's
 * bearer addresses the link itself.
 *
 * The stored Cellular.Interface row carries the modem's netdev, its
 * direction and its sysfs path because the boot render and the stacked
 * IP.Interface read them from the stored tree, long before ModemManager has
 * probed anything. Without a known path the ports are still bridged and the
 * LTE waits for a controller to bind the row.
 *
 * @param {object} config - The router config to transform (mutated in place)
 * @param {object} network - Network capabilities with wan/lan device arrays
 * @param {string} modem_path - Modem sysfs path for this board, may be empty
 * @returns {object} The mutated config
 */
function router_to_cellular(config, network, modem_path) {
	let dev = config.Device;

	wan_links_bridge(config, network);

	let wan = dev.IP.Interface['1'];
	wan.Name = 'wwan0';
	wan.LowerLayers = 'Device.Cellular.Interface.1';
	wan.Upstream = 'true';
	wan.IPv4Enable = 'true';
	wan.IPv6Enable = 'false';
	wan.X_UBBF_CarrierLossDelay = '0';
	delete wan.IPv4Address;
	delete wan.IPv6Address;
	delete wan.IPv6Prefix;

	// The LAN keeps its child prefix row although the parent it names is
	// gone: that row is what gives the LAN its ip6assign, and with it the
	// ULA addressing, exactly as on a router with no upstream prefix.
	delete dev.DHCPv4.Client;
	if (dev.DHCPv6)
		delete dev.DHCPv6.Client;

	for (let key in keys(dev.Firewall?.Chain?.['1']?.Rule ?? {}))
		if (dev.Firewall.Chain['1'].Rule[key].SourceInterface == 'Device.IP.Interface.1')
			delete dev.Firewall.Chain['1'].Rule[key];

	wan_services_drop(dev);

	let modem = {
		Enable: 'true',
		Alias: 'lte',
		Name: 'wwan0',
		Upstream: 'true',
		USIM: { PIN: CELLULAR.sim.PIN }
	};
	if (modem_path)
		modem.X_UBBF_Device = modem_path;
	else
		warn('default_config: no modem path for this board, the cellular WAN waits for a controller\n');

	dev.Cellular = {
		RoamingEnabled: 'false',
		Interface: { '1': modem },
		AccessPoint: {
			'1': {
				Enable: 'true',
				Alias: 'lte',
				APN: CELLULAR.sim.APN,
				Username: CELLULAR.sim.Username,
				Password: CELLULAR.sim.Password,
				Interface: 'Device.Cellular.Interface.1',
				IPVersion: CELLULAR.sim.IPVersion,
				Type: 'default'
			}
		}
	};

	return config;
}

let initial_json = fs.readfile(opts.initial);
if (!initial_json)
	exit(1);

let config = json(initial_json);
if (!config)
	exit(1);

let capabilities_json = fs.readfile(opts.capabilities);
let capabilities = capabilities_json ? json(capabilities_json) : {};
let network = capabilities.network ?? {};
let radios = capabilities.radios ?? {};

let wifi = length(keys(radios)) > 0 ? wifi_generate(radios) : null;
let optical_map = optical_cages_query();

if (length(network.wan) || length(network.lan)) {
	config.Device.Ethernet = ethernet_generate(network, optical_map);
	config.Device.Bridging ??= {};
	config.Device.Bridging.Bridge ??= {};
	config.Device.Bridging.Bridge['1'] = bridging_generate(network, wifi);

	config.Device.WiFi ??= {};
	config.Device.WiFi.DataElements ??= {};
	config.Device.WiFi.DataElements.Network ??= {};
	config.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh ??= {};
	config.Device.WiFi.DataElements.Network.X_UBBF_EasyMesh.Bridge = 'Device.Bridging.Bridge.1';

	// RFC 8325 DSCP -> 802.1D UP mapping. UP2 deliberately absent
	// (consolidated into UP1); unconfigured UPs render as 255,255.
	config.Device.WiFi.X_UBBF_QoSMap = {
		'1': { Enable: 'true', Alias: 'UP0', UserPriority: '0', DSCPList: 'MIN,CS2'   },
		'2': { Enable: 'true', Alias: 'UP1', UserPriority: '1', DSCPList: 'CS1'       },
		'3': { Enable: 'true', Alias: 'UP3', UserPriority: '3', DSCPList: 'AF21,AF23' },
		'4': { Enable: 'true', Alias: 'UP4', UserPriority: '4', DSCPList: 'CS3,AF43'  },
		'5': { Enable: 'true', Alias: 'UP5', UserPriority: '5', DSCPList: 'CS5'       },
		'6': { Enable: 'true', Alias: 'UP6', UserPriority: '6', DSCPList: 'VA,EF'     },
		'7': { Enable: 'true', Alias: 'UP7', UserPriority: '7', DSCPList: 'CS6,CS7'   }
	};

	if (wifi) {
		config.Device.WiFi.Radio = wifi.Radio;
		config.Device.WiFi.SSID = wifi.SSID;
		config.Device.WiFi.AccessPoint = wifi.AccessPoint;
		if (wifi.Templates)
			config.Device.WiFi.Templates = wifi.Templates;
		config.Device.Bridging.Bridge['2'] = guest_bridge_generate(wifi);
		config.Device.QoS = qos_shaper_generate(wifi);
	}
}

let is_developer = !!fs.stat('/etc/ubbf/developer');

let wan_delay = is_developer ? '0' : '90';
for (let idx, iface in config.Device.IP.Interface) {
	if (iface.Upstream == 'true')
		iface.X_UBBF_CarrierLossDelay = wan_delay;
}

if (is_developer) {
	config.Device.SSH = {
		Enable: 'true',
		Server: {
			'1': {
				Enable: 'true',
				Alias: 'DevSSH',
				Interface: '',
				Port: '22',
				IdleTimeout: '300',
				KeepAlive: '300',
				AllowRootLogin: 'true',
				AllowPasswordLogin: 'true',
				AllowRootPasswordLogin: 'true',
				MaxAuthTries: '3'
			}
		}
	};
	config.Device.Firewall ??= {};
	config.Device.Firewall.Chain ??= {};
	config.Device.Firewall.Chain['1'] ??= {
		Enable: 'true',
		Alias: 'InputChain',
		Name: 'INPUT'
	};
	config.Device.Firewall.Chain['1'].Rule ??= {};
	config.Device.Firewall.Chain['1'].Rule['1'] = {
		Enable: 'true',
		Alias: 'WANDevSSH',
		Target: 'Accept',
		Protocol: '6',
		DestPort: '22',
