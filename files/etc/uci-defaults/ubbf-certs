#!/bin/sh

CERT_DIR=/etc/ubbf

[ -f /usr/bin/pkgen -a ! -f $CERT_DIR/cert.pem ] && {
	mkdir -p $CERT_DIR
	. /lib/functions/system.sh
	cn=$(get_mac_label)
	[ -z "$cn" ] && for dev in $(jsonfilter -i /etc/board.json -e '@.network.*.device' -e '@.network.*.ports[*]'); do
		[ -r /sys/class/net/$dev/address ] || continue
		cn=$(cat /sys/class/net/$dev/address)
		break
	done
	cn=$(echo $cn | tr -d : | awk '{print tolower($0)}')
	(
		umask 077
		/usr/bin/pkgen -s CN=$cn,O=OpenWrt ca $CERT_DIR/ca.pem
		/usr/bin/pkgen -s CN=$cn,O=OpenWrt cert $CERT_DIR/ca.pem $CERT_DIR/cert.pem
	)
}

exit 0
