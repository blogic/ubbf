#!/bin/sh /etc/rc.common

START=51
STOP=89

USE_PROCD=1
# Native ucode daemon talking to logd via ubus subscriber + initial
# ring drain. Replaces the earlier `logread-ubox -r` shim which lost
# messages logged before the bridge connected and during syslog-ng
# reload windows.
PROG=/usr/libexec/ubbf/syslog-bridge

start_service() {
	procd_open_instance ubbf-syslog-bridge
	procd_set_param command "$PROG" -h "$(uci get system.@system[0].hostname)"
	procd_set_param respawn 5 5 -1
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger system
}
