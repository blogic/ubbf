{
  "Device": {
    "Ethernet": {
      "InterfaceNumberOfEntries": "3",
      "LinkNumberOfEntries": "3",
      "Interface": {
        "1": {
          "Enable": "true",
          "Alias": "eth0",
          "Name": "eth0",
          "MaxBitRate": "-1",
          "DuplexMode": "Auto"
        },
        "2": {
          "Enable": "true",
          "Alias": "eth1",
          "Name": "eth1",
          "MaxBitRate": "-1",
          "DuplexMode": "Auto"
        },
        "3": {
          "Enable": "true",
          "Alias": "eth2",
          "Name": "eth2",
          "MaxBitRate": "-1",
          "DuplexMode": "Auto"
        }
      },
      "Link": {
        "1": {
          "Enable": "true",
          "Alias": "EthLink1",
          "Name": "ethlink0",
          "LowerLayers": "Device.Ethernet.Interface.1",
          "MACAddress": ""
        },
        "2": {
          "Enable": "true",
          "Alias": "EthLink2",
          "Name": "ethlink1",
          "LowerLayers": "Device.Ethernet.Interface.2",
          "MACAddress": ""
        },
        "3": {
          "Enable": "true",
          "Alias": "EthLink3",
          "Name": "ethlink2",
          "LowerLayers": "Device.Ethernet.Interface.3",
          "MACAddress": ""
        }
      }
    },

    "Bridging": {
      "BridgeNumberOfEntries": "1",
      "Bridge": {
        "1": {
          "Enable": "true",
          "Alias": "LanBridge",
          "Standard": "802.1Q-2011",
          "PortNumberOfEntries": "4",
          "Port": {
            "1": {
              "Enable": "true",
              "Alias": "lan",
              "Name": "lan",
              "ManagementPort": "true",
              "LowerLayers": ""
            },
            "2": {
              "Enable": "true",
              "Alias": "LanPort1",
              "Name": "lanport1",
              "ManagementPort": "false",
              "LowerLayers": "Device.Ethernet.Link.2"
            },
            "3": {
              "Enable": "true",
              "Alias": "LanPort2",
              "Name": "lanport2",
              "ManagementPort": "false",
              "LowerLayers": "Device.Ethernet.Link.3"
            },
            "4": {
              "Enable": "true",
              "Alias": "WiFiPort",
              "Name": "wifiport",
              "ManagementPort": "false",
              "LowerLayers": "Device.WiFi.SSID.1,Device.WiFi.SSID.2"
            }
          }
        }
      }
    },

    "IP": {
      "InterfaceNumberOfEntries": "2",
      "Interface": {
        "1": {
          "Enable": "true",
          "Alias": "WAN",
          "Name": "wan",
          "LowerLayers": "Device.Ethernet.Link.1",
          "Upstream": "true",
          "Type": "Normal",
          "IPv4Enable": "true",
          "IPv6Enable": "true",
          "IPv4AddressNumberOfEntries": "1",
          "IPv6AddressNumberOfEntries": "1",
          "IPv4Address": {
            "1": {
              "Enable": "true",
              "Alias": "WanIPv4",
              "IPAddress": "",
              "SubnetMask": "",
              "AddressingType": "DHCP"
            }
          },
          "IPv6Address": {
            "1": {
              "Enable": "true",
              "Alias": "WanIPv6",
              "IPAddress": "",
              "Origin": "DHCPv6",
              "Prefix": ""
            }
          }
        },
        "2": {
          "Enable": "true",
          "Alias": "LAN",
          "Name": "lan",
          "LowerLayers": "Device.Bridging.Bridge.1.Port.1",
          "Upstream": "false",
          "Type": "Normal",
          "IPv4Enable": "true",
          "IPv6Enable": "true",
          "IPv4AddressNumberOfEntries": "1",
          "IPv6AddressNumberOfEntries": "1",
          "IPv6PrefixNumberOfEntries": "1",
          "IPv4Address": {
            "1": {
              "Enable": "true",
              "Alias": "LanIPv4",
              "IPAddress": "192.168.1.1",
              "SubnetMask": "255.255.255.0",
              "AddressingType": "Static"
            }
          },
          "IPv6Address": {
            "1": {
              "Enable": "true",
              "Alias": "LanIPv6",
              "IPAddress": "",
              "Origin": "PrefixDelegation",
              "Prefix": "Device.IP.Interface.2.IPv6Prefix.1"
            }
          },
          "IPv6Prefix": {
            "1": {
              "Enable": "true",
              "Alias": "LanPrefix",
              "Prefix": "",
              "Origin": "PrefixDelegation",
              "ParentPrefix": "Device.DHCPv6.Client.1.Server.1.Prefix.1"
            }
          }
        }
      }
    },

    "DHCPv4": {
      "ClientNumberOfEntries": "1",
      "Client": {
        "1": {
          "Enable": "true",
          "Alias": "WanDHCPv4Client",
          "Interface": "Device.IP.Interface.1",
          "Status": "Enabled",
          "Renew": "false"
        }
      },
      "Server": {
        "Enable": "true",
        "PoolNumberOfEntries": "1",
        "Pool": {
          "1": {
            "Enable": "true",
            "Alias": "LanPool",
            "Interface": "Device.IP.Interface.2",
            "MinAddress": "192.168.1.100",
            "MaxAddress": "192.168.1.200",
            "SubnetMask": "255.255.255.0",
            "LeaseTime": "86400",
            "DNSServers": "192.168.1.1",
            "DomainName": "lan.local",
            "IPRouters": "192.168.1.1",
            "StaticAddressNumberOfEntries": "2",
            "StaticAddress": {
              "1": {
                "Enable": "true",
                "Alias": "StaticLease1",
                "Chaddr": "AA:BB:CC:DD:EE:01",
                "Yiaddr": "192.168.1.10"
              },
              "2": {
                "Enable": "true",
                "Alias": "StaticLease2",
                "Chaddr": "AA:BB:CC:DD:EE:02",
                "Yiaddr": "192.168.1.11"
              }
            }
          }
        }
      }
    },

    "DHCPv6": {
      "ClientNumberOfEntries": "1",
      "Client": {
        "1": {
          "Enable": "true",
          "Alias": "WanDHCPv6Client",
          "Interface": "Device.IP.Interface.1",
          "Status": "Enabled",
          "RequestAddresses": "true",
          "RequestPrefixes": "true",
          "SuggestedT1": "-1",
          "SuggestedT2": "-1"
        }
      }
    },

    "Firewall": {
      "Enable": "true",
      "Config": "Advanced",
      "AdvancedLevel": "Device.Firewall.Level.1",
      "LevelNumberOfEntries": "1",
      "ChainNumberOfEntries": "2",
      "Level": {
        "1": {
          "Alias": "DefaultLevel",
          "Name": "Default",
          "Description": "Default firewall level",
          "DefaultPolicy": "Drop"
        }
      },
      "Chain": {
        "1": {
          "Enable": "true",
          "Alias": "InputChain",
          "Name": "INPUT",
          "RuleNumberOfEntries": "1",
          "Rule": {
            "1": {
              "Enable": "true",
              "Alias": "AllowLAN",
              "SourceInterface": "Device.IP.Interface.2",
              "Target": "Accept"
            }
          }
        },
        "2": {
          "Enable": "true",
          "Alias": "ForwardChain",
          "Name": "FORWARD",
          "RuleNumberOfEntries": "1",
          "Rule": {
            "1": {
              "Enable": "true",
              "Alias": "LANtoWAN",
              "SourceInterface": "Device.IP.Interface.2",
              "DestInterface": "Device.IP.Interface.1",
              "Target": "Accept"
            }
          }
        }
      }
    },

    "NAT": {
      "InterfaceSettingNumberOfEntries": "1",
      "InterfaceSetting": {
        "1": {
          "Enable": "true",
          "Alias": "WanNAT",
          "Interface": "Device.IP.Interface.1",
          "Status": "Enabled"
        }
      }
    },

    "Time": {
      "Enable": "true",
      "LocalTimeZone": "CET-1CEST,M3.5.0,M10.5.0/3",
      "ClientNumberOfEntries": "1",
      "ServerNumberOfEntries": "1",
      "Client": {
        "1": {
          "Enable": "true",
          "Alias": "NTPClient",
          "Servers": "0.pool.ntp.org,1.pool.ntp.org"
        }
      },
      "Server": {
        "1": {
          "Enable": "true",
          "Alias": "NTPServer",
          "Interface": "Device.IP.Interface.2"
        }
      }
    },

    "WiFi": {
      "RadioNumberOfEntries": "2",
      "SSIDNumberOfEntries": "2",
      "AccessPointNumberOfEntries": "2",
      "Radio": {
        "1": {
          "Enable": "true",
          "Alias": "Radio2G",
          "Name": "radio0",
          "OperatingFrequencyBand": "2.4GHz",
          "OperatingStandards": "g,n,ax",
          "Channel": "0",
          "AutoChannelEnable": "true",
          "OperatingChannelBandwidth": "20MHz",
          "TransmitPower": "100"
        },
        "2": {
          "Enable": "true",
          "Alias": "Radio5G",
          "Name": "radio1",
          "OperatingFrequencyBand": "5GHz",
          "OperatingStandards": "a,n,ac,ax",
          "Channel": "0",
          "AutoChannelEnable": "true",
          "OperatingChannelBandwidth": "80MHz",
          "TransmitPower": "100"
        }
      },
      "SSID": {
        "1": {
          "Enable": "true",
          "Alias": "SSID2G",
          "Name": "wlan0",
          "LowerLayers": "Device.WiFi.Radio.1",
          "SSID": "MyNetwork_2G",
          "MACAddress": ""
        },
        "2": {
          "Enable": "true",
          "Alias": "SSID5G",
          "Name": "wlan1",
          "LowerLayers": "Device.WiFi.Radio.2",
          "SSID": "MyNetwork_5G",
          "MACAddress": ""
        }
      },
      "AccessPoint": {
        "1": {
          "Enable": "true",
          "Alias": "AP2G",
          "SSIDReference": "Device.WiFi.SSID.1",
          "SSIDAdvertisementEnabled": "true",
          "WMMEnable": "true",
          "Security": {
            "ModeEnabled": "WPA2-Personal",
            "WPAEncryptionModes": "AESEncryption",
            "PreSharedKey": "YourSecurePassword123"
          }
        },
        "2": {
          "Enable": "true",
          "Alias": "AP5G",
          "SSIDReference": "Device.WiFi.SSID.2",
          "SSIDAdvertisementEnabled": "true",
          "WMMEnable": "true",
          "Security": {
            "ModeEnabled": "WPA2-Personal",
            "WPAEncryptionModes": "AESEncryption",
            "PreSharedKey": "YourSecurePassword123"
          }
        }
      }
    },

    "DNS": {
      "Client": {
        "Enable": "true",
        "ServerNumberOfEntries": "2",
        "Server": {
          "1": {
            "Enable": "true",
            "Alias": "PrimaryDNS",
            "DNSServer": "8.8.8.8",
            "Type": "Static"
          },
          "2": {
            "Enable": "true",
            "Alias": "SecondaryDNS",
            "DNSServer": "8.8.4.4",
            "Type": "Static"
          }
        }
      },
      "Relay": {
        "Enable": "true",
        "ForwardingNumberOfEntries": "1",
        "Forwarding": {
          "1": {
            "Enable": "true",
            "Alias": "LanForwarder",
            "DNSServer": "8.8.8.8",
            "IngressInterface": "Device.IP.Interface.2"
          }
        },
        "Caching": {
          "Enable": "true",
          "MaxEntries": "1000",
          "MaxTTL": "86400",
          "MinTTL": "0",
          "NegativeTTL": "3600"
        }
      },
      "RebindProtection": {
        "Enable": "true",
        "AllowedDomains": "lan.local"
      },
      "SD": {
        "Enable": "true",
        "AdvertiseNumberOfEntries": "1",
        "Advertise": {
          "1": {
            "Enable": "true",
            "Alias": "RouterWeb",
            "InstanceName": "Router Web Interface",
            "ServiceName": "_http._tcp",
            "Port": "80",
            "TextRecord": {
              "1": {
                "Key": "path",
                "Value": "/"
              }
            }
          }
        }
      }
    },

    "SSH": {
      "Enable": "true",
      "Status": "Enabled",
      "Port": "22",
      "AllowedInterface": "Device.IP.Interface.2",
      "IdleTimeout": "300",
      "KeepAlive": "true"
    }
  }
}
